# Copy this to .env for LOCAL development only.
# In Railway, set these as environment variables in the service's Variables tab instead —
# never commit a real .env file to git.

# Railway gives you DATABASE_URL automatically when you add a Postgres plugin.
# Use DATABASE_PUBLIC_URL only if connecting from outside Railway's network (e.g. your laptop).
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# The password required to reach the "Create New Account" page.
# Rotate this to something new since the old one was shared in a document.
ADMIN_PASSWORD=replace-with-a-new-admin-password

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5500,https://your-frontend.vercel.app

PORT=3000
